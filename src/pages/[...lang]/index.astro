---
// The landing: the two calls to action and the video at first sight, the practices half in view at the foot of the screen, then the team, the colleagues and the contact.
import Base from '../../layouts/Base.astro';
import VideoFond from '../../components/VideoFond.astro';
import OuvertureImplant from '../../components/OuvertureImplant.astro';
import Defile from '../../components/Defile.astro';
import Equipe from '../../components/Equipe.astro';
import { DRAFT, PRATICIEN } from '../../config';
import { CATEGORIES } from '../../data/categories';
import { VIDEOS, VIDEO_DEMO } from '../../data/medias';
import { UI, asset, href, localePaths, type Lang } from '../../i18n';

export function getStaticPaths() { return localePaths(); }
const lang = Astro.props.lang as Lang;
const t = UI[lang];
const v = PRATICIEN.ville;
const C = {
  fr: {
    titre: `Dr Paul Fournier, dentiste à ${v} et Brioude`,
    desc: `Dr Paul Fournier, chirurgien-dentiste à ${v} (Jaude) et Brioude : implants dentaires, greffe osseuse, dents de sagesse, chirurgie sous anesthésie générale. Rendez-vous par téléphone.`,
    h1: 'Docteur Paul Fournier, chirurgien-dentiste',
    voir: 'Voir',
    lieux: 'Cabinets dentaires de Jaude à Clermont-Ferrand et de Brioude, et la clinique. Rendez-vous par téléphone.',
  },
  en: {
    titre: `Dr Paul Fournier, dentist in ${v} and Brioude, France`,
    desc: `Dr Paul Fournier, dental surgeon in ${v} (Jaude) and Brioude, France: dental implants, bone grafts, wisdom teeth, surgery under general anaesthesia. Appointments by phone.`,
    h1: 'Doctor Paul Fournier, dental surgeon',
    voir: 'See',
    lieux: 'Dental practices at Jaude in Clermont-Ferrand and in Brioude, and the clinic. Appointments by phone.',
  },
}[lang];
const tuile = (c: keyof typeof CATEGORIES) => ({ h: href(lang, c), nom: CATEGORIES[c].nom[lang], p: CATEGORIES[c].phrase[lang] });
const confreres = tuile('confreres'), contact = tuile('contact');
// The film of the first screen, and its still, fetched first: it is the largest thing on the screen
const film = VIDEOS[0].src || !DRAFT ? VIDEOS[0] : VIDEO_DEMO;
const ld = [{ '@type': 'WebPage', '@id': new URL(href(lang), Astro.site).href, name: C.titre, about: { '@id': `${new URL('/', Astro.site).href}#paul-fournier` }, inLanguage: lang }];
---
<Base lang={lang} titre={C.titre} description={C.desc} ld={ld} ouverture affiche={film.poster ? asset(film.poster) : undefined} affichePetite={'posterPetit' in film && film.posterPetit ? asset(film.posterPetit) : undefined}>
  <OuvertureImplant lang={lang} />
  <section class="accueil">
    <h1 class="accueil-nom">{C.h1}</h1>
    <VideoFond video={film} lang={lang} />
  </section>
  <Defile lang={lang} />
  <Equipe lang={lang} />
  <section class="bento bento-deux">
    <a class="tuile" href={confreres.h}><h2>{confreres.nom}</h2><p>{confreres.p}</p><span class="fleche">{C.voir}</span></a>
    <a class="tuile" href={contact.h}><h2>{contact.nom}</h2><p>{C.lieux}</p><span class="fleche">{C.voir}</span></a>
  </section>
</Base>
