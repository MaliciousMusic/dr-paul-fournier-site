---
// The landing: the two calls to action and the video at first sight, the practices half in view at the foot of the screen, then every section at a glance.
import Base from '../../layouts/Base.astro';
import VideoFond from '../../components/VideoFond.astro';
import OuvertureImplant from '../../components/OuvertureImplant.astro';
import Defile from '../../components/Defile.astro';
import { DRAFT, PRATICIEN } from '../../config';
import { PRATIQUES } from '../../data/pratiques';
import { CATEGORIES } from '../../data/categories';
import { VIDEOS, VIDEO_DEMO } from '../../data/medias';
import { UI, href, localePaths, type Lang } from '../../i18n';

export function getStaticPaths() { return localePaths(); }
const lang = Astro.props.lang as Lang;
const t = UI[lang];
const v = PRATICIEN.ville;
const C = {
  fr: {
    titre: `Dr Paul Fournier, chirurgien-dentiste à ${v}`,
    desc: `Le Dr Paul Fournier est chirurgien-dentiste à ${v} : implants, régénération osseuse, dents de sagesse, chirurgie sous anesthésie générale.`,
    h1: 'Docteur Paul Fournier, chirurgien-dentiste',
    voir: 'Voir',
    lieux: 'Jaude, Brioude et la clinique, rendez-vous par téléphone.',
  },
  en: {
    titre: `Dr Paul Fournier, dental surgeon in ${v}, France`,
    desc: `Dr Paul Fournier is a dental surgeon in ${v}, France: implants, bone regeneration, full reconstruction, wisdom teeth, surgery under general anaesthesia.`,
    h1: 'Doctor Paul Fournier, dental surgeon',
    voir: 'See',
    lieux: 'Jaude, Brioude and the clinic, appointments by phone.',
  },
}[lang];
const tuile = (c: keyof typeof CATEGORIES) => ({ h: href(lang, c), nom: CATEGORIES[c].nom[lang], p: CATEGORIES[c].phrase[lang] });
const parcours = tuile('parcours'), confreres = tuile('confreres'), medias = tuile('medias'), articles = tuile('articles'), evenements = tuile('evenements'), contact = tuile('contact');
const ld = [{ '@type': 'WebPage', '@id': new URL(href(lang), Astro.site).href, name: C.titre, about: { '@id': `${new URL('/', Astro.site).href}#paul-fournier` }, inLanguage: lang }];
---
<Base lang={lang} titre={C.titre} description={C.desc} ld={ld} ouverture>
  <OuvertureImplant lang={lang} />
  <section class="accueil">
    <h1 class="accueil-nom">{C.h1}</h1>
    <VideoFond video={VIDEOS[0].src || !DRAFT ? VIDEOS[0] : VIDEO_DEMO} lang={lang} />
  </section>
  <Defile lang={lang} />
  <section>
      <div class="bento bento-plein">
        <div class="tuile tuile-large">
          <h2><a href={href(lang, 'pratiques')} style="text-decoration:none">{CATEGORIES.pratiques.nom[lang]}</a></h2>
          <ul class="liens">
            {PRATIQUES.map((p) => <li><a href={href(lang, `pratiques/${p.slug}`)}>{p.titre[lang]}</a></li>)}
          </ul>
        </div>
        <a class="tuile" href={confreres.h}><h2>{confreres.nom}</h2><p>{confreres.p}</p><span class="fleche">{C.voir}</span></a>
        <a class="tuile" href={parcours.h}><h2>{parcours.nom}</h2><p>{parcours.p}</p><span class="fleche">{C.voir}</span></a>
        <a class="tuile" href={medias.h}><h2>{medias.nom}</h2><p>{medias.p}</p><span class="fleche">{C.voir}</span></a>
        <a class="tuile" href={articles.h}><h2>{articles.nom}</h2><p>{articles.p}</p><span class="fleche">{C.voir}</span></a>
        <a class="tuile" href={evenements.h}><h2>{evenements.nom}</h2><p>{evenements.p}</p><span class="fleche">{C.voir}</span></a>
        <a class="tuile" href={contact.h}><h2>{contact.nom}</h2><p>{C.lieux}</p><span class="fleche">{C.voir}</span></a>
      </div>
  </section>
</Base>
