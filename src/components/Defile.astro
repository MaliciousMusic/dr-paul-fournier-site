---
// The practices, on the ruler, scrolling right to left in a loop at the foot of the first screen. Each one leads to its page.
// Hover, focus or a tap holds it. Cells are as wide as a whole number of ruler divisions, so the ruler joins without a seam.
// The page holds one copy, the script adds what the loop needs. No JavaScript or reduced motion: a band scrolled by hand.
import { PRATIQUES } from '../data/pratiques';
import { href, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const nom = lang === 'fr' ? 'Pratiques du Dr Paul Fournier' : 'Treatments by Dr Paul Fournier';
---
<nav id="defile" class="defile" style={`--n:${PRATIQUES.length}`} aria-label={nom}>
  <div class="defile-piste">
    <div class="regle" aria-hidden="true"></div>
    <ul class="reperes">
      {PRATIQUES.map((p) => <li><a href={href(lang, `pratiques/${p.slug}`)}>{p.titre[lang]}</a></li>)}
    </ul>
  </div>
</nav>
<script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var d = document.getElementById('defile'), piste = d.firstElementChild, liste = piste.querySelector('.reperes');
    var copies = Math.ceil(Math.max(innerWidth, screen.width) / liste.offsetWidth) + 1;
    for (var i = 1; i < copies; i++) {
      var c = liste.cloneNode(true);
      c.setAttribute('aria-hidden', 'true');
      c.querySelectorAll('a').forEach(function (a) { a.tabIndex = -1; });
      piste.appendChild(c);
    }
    piste.style.setProperty('--copies', copies);
    d.classList.add('roule');
    d.addEventListener('pointerdown', function (e) { if (e.pointerType === 'touch') d.classList.toggle('arret'); });
  })();
</script>
