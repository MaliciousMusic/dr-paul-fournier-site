---
// The intro video as a background: silent loop that starts by itself, with visible pause and sound controls.
// Until the video exists: its poster, or in the working version the placeholder photo.
import { DRAFT } from '../config';
import { asset, type Lang } from '../i18n';
interface Props { video: { titre: Record<Lang, string>; src: string; poster: string }; lang: Lang }
const { video, lang } = Astro.props;
const image = video.poster || (DRAFT ? asset('video-attente.webp') : '');
const L = {
  fr: { alt: 'Parapentiste en vol au-dessus de montagnes enneigées', pause: 'Mettre en pause', lecture: 'Lire', son: 'Activer le son', muet: 'Couper le son' },
  en: { alt: 'Paraglider flying above snow-capped mountains', pause: 'Pause', lecture: 'Play', son: 'Turn sound on', muet: 'Mute' },
}[lang];
---
<div class="fond-video">
  {video.src ? (
    <>
      <video id="video-intro" autoplay muted loop playsinline preload="metadata" poster={image || undefined} src={video.src} aria-label={video.titre[lang]}></video>
      <div class="fond-cmd" id="video-cmd" data-pause={L.pause} data-lecture={L.lecture} data-son={L.son} data-muet={L.muet}>
        <button type="button" data-action="pause">{L.pause}</button>
        <button type="button" data-action="son">{L.son}</button>
      </div>
    </>
  ) : image ? (
    <img src={image} alt={L.alt} width="867" height="1024" fetchpriority="high" decoding="async" />
  ) : null}
</div>
<script>
  const v = document.getElementById('video-intro') as HTMLVideoElement | null;
  const cmd = document.getElementById('video-cmd');
  if (v && cmd) {
    const [pause, son] = cmd.querySelectorAll('button');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) v.pause();
    const maj = () => {
      pause.textContent = v.paused ? cmd.dataset.lecture! : cmd.dataset.pause!;
      son.textContent = v.muted ? cmd.dataset.son! : cmd.dataset.muet!;
    };
    pause.addEventListener('click', () => { v.paused ? v.play() : v.pause(); });
    son.addEventListener('click', () => { v.muted = !v.muted; if (!v.muted) v.play(); maj(); });
    v.addEventListener('play', maj);
    v.addEventListener('pause', maj);
    maj();
  }
</script>
